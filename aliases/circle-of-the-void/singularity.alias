embed <drac2>
# !singularity [-i]
# Collapse into Nothing: Singularity (Circle of the Void, Druid 14). 1/Long Rest.
a = argparse(&ARGS&)
ch = character()
c = combat()
me = c.me if c else None
lvl = ch.levels.get("Druid")
dc = ch.spellbook.dc or (8 + proficiencyBonus + wisdomMod)
cc = "Singularity"
T = "Singularity"
C = "-color #2b1a40"

if lvl < 14:
  return f'-title "{T}" -desc "Requires Druid level 14." {C}'

ch.create_cc_nx(cc, minVal=0, maxVal=1, reset="long", dispType="bubble", title=cc, desc="Collapse into Nothing, 1/Long Rest.")
used = ""
if not a.last("i"):
  if ch.get_cc(cc) < 1:
    return f'-title "{T}" -desc "You have already used Singularity. It recharges on a Long Rest." {C}'
  ch.mod_cc(cc, -1)
  used = f"\n**{cc}:** {ch.cc_str(cc)} (-1)"

vortex = f"Each other creature that **starts its turn** in the area makes a **DC {dc} Strength** save. On a failure it is **pulled 10 ft** toward the center and takes **3d6 Psychic**. On a success it takes half damage and is not pulled.\nRun `{ctx.prefix}pulse -t <target>` at the start of each creature's turn."
collapse = "A creature reduced to 0 HP by this is consumed by swirling darkness. At your option it is either instantly **killed** (its body dissolves into black ash) or **transported** to a harmless demiplane of emptiness, stabilizing at 0 HP and returning when the singularity ends."
mastery = "While concentrating on your Singularity or on any spell that deals necrotic or psychic damage in an area, you have **Resistance** to all damage except Force, Radiant, and Psychic."
erode = "Terrain and nonmagical objects in the area become heavily pitted or eroded by the end of the minute. Floors may weaken, walls shatter, and structures degrade, at the DM's discretion."

note = ""
if me:
  res = ["acid", "bludgeoning", "cold", "fire", "lightning", "necrotic", "piercing", "poison", "slashing", "thunder"]
  if me.get_effect(T):
    me.remove_effect(T)
  me.add_effect(T, duration=10, concentration=True, passive_effects={"resistances": res}, desc=f"15-ft-radius vortex within 60 ft (Concentration, 1 minute). Start-of-turn DC {dc} STR save. Void's Mastery: resistance to all damage except force, radiant and psychic.")
  note = "\n\nAdded concentration effect **Singularity** (1 min) with Void's Mastery resistances."

return f'-title "{name} collapses the world into nothing" -desc "A **15-foot-radius** swirling vortex of emptiness appears at a point you can see within **60 feet** and lasts **1 minute** (Concentration). You can exclude yourself from its effects.{used}" -f "Singularity|{vortex}" -f "Entropic Collapse|{collapse}" -f "Erosion|{erode}" -f "Void\'s Mastery|{mastery}{note}" -footer "Circle of the Void | Collapse into Nothing" {C}'
</drac2>
